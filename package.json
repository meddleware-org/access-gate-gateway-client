{
  "name": "@meddleware/access-gate-gateway-client",
  "version": "0.0.19",
  "homepage": "https://docs.meddleware.co.uk/blockchain/sui/access-gate/",
  "type": "module",
  "description": "The access-gate gateway wire protocol, client side: challenge fetching, the signed personal message and access-proof encoding. No runtime dependencies.",
  "author": "MeddleWare <dev@meddleware.co.uk>",
  "license": "0BSD",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meddleware-org/access-gate-gateway-client.git"
  },
  "keywords": [
    "sui",
    "access-gate-gateway",
    "access-control",
    "web3"
  ],
  "files": [
    "src",
    "dist",
    "vectors.json",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./vectors.json": "./vectors.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:js": "eslint .",
    "lint": "npm run lint:js",
    "gen:vectors": "node scripts/gen-vectors.mjs > vectors.json",
    "check:vectors": "node scripts/gen-vectors.mjs | diff -q - vectors.json"
  },
  "devDependencies": {
    "@mysten/sui": "^2.35.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@types/node": "~26.6.5",
    "eslint": "^10.11.0",
    "jiti": "^2.7.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "~5.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "not dead"
  ]
}
